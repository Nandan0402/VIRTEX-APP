/**
 * ==============================================================================
 * config.h.example - Template for Gym Receptionist Robot Configuration
 * Target Board: ESP32 DevKit V1 (ESP-WROOM-32)
 *
 * INSTRUCTIONS:
 * 1. Copy this file and save it as "config.h" in the same directory.
 * 2. Update WIFI_SSID and WIFI_PASSWORD with your 2.4 GHz network credentials.
 * 3. Update BACKEND_BASE_URL with your computer's local LAN IP (e.g. 192.168.1.50).
 * 4. config.h is ignored by git (.gitignore) to keep your credentials private.
 * ==============================================================================
 */

#ifndef CONFIG_H
#define CONFIG_H

#include <Arduino.h>

// ==============================================================================
// 1. Wi-Fi Configuration (2.4 GHz Network Only - ESP32 does not support 5 GHz)
// ==============================================================================
#define WIFI_SSID             "YOUR_WIFI_SSID"
#define WIFI_PASSWORD         "YOUR_WIFI_PASSWORD"

// Maximum attempts before backoff
#define WIFI_CONNECT_TIMEOUT_MS  15000

// ==============================================================================
// 2. Node.js Backend Server & Device Authentication
// ==============================================================================
// IMPORTANT: Use your development PC's local network IP (e.g. "http://192.168.1.100:3000/api").
// DO NOT use "localhost" or "127.0.0.1", because from the ESP32's perspective,
// "localhost" is the ESP32 chip itself!
#define BACKEND_BASE_URL      "http://192.168.1.100:3000/api"

// Hardware Device Authentication Headers (must match backend .env / robot_devices table)
#define ROBOT_DEVICE_UUID     "ESP32_RECEPTION_01"
#define ROBOT_API_KEY         "gym_robot_secret_key_12345"

// Non-blocking polling intervals
#define COMMAND_POLL_INTERVAL_MS   1200   // Poll command queue every 1.2 seconds
#define HEARTBEAT_INTERVAL_MS      8000   // Send telemetry heartbeat every 8 seconds

// ==============================================================================
// 3. Hardware Pin Mapping (ESP32 DevKit V1 -> 3x SG90 Servos)
// ==============================================================================
#define PIN_SERVO_HEAD        18   // GPIO 18 -> Signal pin of Head Servo (SG90 #1)
#define PIN_SERVO_LEFT_ARM    19   // GPIO 19 -> Signal pin of Left Arm Servo (SG90 #2)
#define PIN_SERVO_RIGHT_ARM   21   // GPIO 21 -> Signal pin of Right Arm Servo (SG90 #3)

#define PIN_STATUS_LED        2    // Onboard Blue LED on ESP32 DevKit V1

// ==============================================================================
// 4. Safe Physical Travel Limits (0° to 180° Range Clamping)
// ==============================================================================
// Constrains travel to protect nylon gears from physical mechanical end-stops.
#define SERVO_HEAD_MIN        30
#define SERVO_HEAD_MAX        150
#define SERVO_HEAD_NEUTRAL    90

#define SERVO_LEFT_MIN        15
#define SERVO_LEFT_MAX        160
#define SERVO_LEFT_IDLE       20

#define SERVO_RIGHT_MIN       15
#define SERVO_RIGHT_MAX       160
#define SERVO_RIGHT_IDLE      20

#endif // CONFIG_H

