# ==============================================================================
# Virtex AI Gym Receptionist Robot - Environment Configuration
# ==============================================================================

# Server Settings
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Security & CORS Whitelist (Comma-separated origins permitted in production; leave blank for all origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication Secrets (Admin & Trainer Portal)
JWT_SECRET=virtex_super_secret_jwt_key_987654321_secure
JWT_EXPIRES_IN=8h

# Device-Specific ESP32 Hardware Authentication
ROBOT_DEVICE_UUID=ESP32_RECEPTION_01
ROBOT_API_KEY=gym_robot_secret_key_12345

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_robot_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=5000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# AI Configuration (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=8000

# Default Receptionist Speech Configurations
DEFAULT_LANGUAGE=en-IN
SUPPORTED_LANGUAGES=en-IN,kn-IN,hi-IN

# Google OAuth 2.0 Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
